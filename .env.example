# HTTP port supplied by the hosting platform. Defaults to 3000.
PORT=3000

# Persistent PostgreSQL connection string (required in production).
DATABASE_URL="postgresql://user:password@host:5432/finance?sslmode=require"

# Set to true only if your provider requires explicit TLS configuration.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Telegram bot token from @BotFather (required for Telegram Mini App authorization).
BOT_TOKEN="123456789:replace_with_bot_token"

# Long random value for direct-browser sessions. BOT_TOKEN is used as a fallback.
SESSION_SECRET="replace_with_a_long_random_secret"

# Telegram authorization freshness window. Defaults to 24 hours.
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# Public HTTPS address used when configuring the Mini App in @BotFather.
APP_URL="https://your-app.example.com"
